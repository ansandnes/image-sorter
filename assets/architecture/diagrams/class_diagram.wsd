@startuml Image-Sorter

class ImagePath {
    +path : str
    --
    +is_valid() : bool
    +get_path()
}

class ImageGPS {
    +latitude : tuple | None
    +latitude_ref : bytes | None
    +longitude : tuple | None
    +longitude_ref : bytes | None
    --
    +get_coords() : dict
    +get_latitude()
    +get_latitude_ref()
    +get_longitude()
    +get_longitude_ref()
}

class Location {
    +country : str
    +city : str
    --
    +get_location() : dict
    +get_country() : str
    +get_city() : str
}

class ImageMetadata {
    +dir : str | None
    +name : str | None
    +timestamp : str | None
    +coords : ImageGPS
    +location : Location
    --
    +set_coords(longitude, longitude_ref, latitude, latitude_ref)
    +set_location(location : Location)
    +get_name()
    +get_timestamp()
    +get_coords()
    +get_location()
}

class MetadataService <<module>> {
    --
    +create_image_metadata(timestamp, coords, image_dir, filename) : ImageMetadata
    +convert_coord_to_decimal_number(coord, ref) : float
    +get_location_from_gps(lat, lon, image_dir) : Location
}

class OrganizerService <<module>> {
    --
    +organize_images(image_dir, image_metadata, filename, dry_run=False) : str | None
}

class ProcessingState <<module>> {
    --
    +initialize_processing_state(image_dir) : str
    +compute_file_hash(file_path) : str
    +is_hash_processed(db_path, file_hash) : bool
    +record_processed_image(db_path, file_hash, original_path, destination_path)
}

class MainCLI <<module>> {
    --
    +parse_args() : argparse.Namespace
    +main()
}

' --- RELATIONSHIPS ---

ImageMetadata "1" *-- "1" ImageGPS : has
ImageMetadata "1" *-- "1" Location : has

MetadataService ..> ImageMetadata : builds
MetadataService ..> ImageGPS : reads
MetadataService ..> Location : resolves
OrganizerService ..> ImageMetadata : uses
MainCLI ..> ImagePath : validates input path
MainCLI ..> MetadataService : creates metadata
MainCLI ..> OrganizerService : moves files
MainCLI ..> ProcessingState : idempotency store

@enduml


