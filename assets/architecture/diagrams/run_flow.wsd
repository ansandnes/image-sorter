@startuml Image-Sorter-Run-Flow

actor User
participant "Launcher\n(.bat / .command / .sh)" as Launcher
participant MainCLI
participant "Scanner\n(scan_unsorted)" as Scanner
participant "ExifTool" as ExifTool
participant "Metadata Service\n(create_image_metadata)" as MetadataService
participant "GeoLookup\n(offline GeoNames)" as GeoLookup
participant "ProcessingState\n(SQLite)" as ProcessingState
participant "Organizer\n(plan_moves / execute_moves)" as Organizer

User -> Launcher: double-click
Launcher -> MainCLI: bundled python main.py --root <drive>
MainCLI -> MainCLI: AppPaths(root).ensure_folders()
MainCLI -> Scanner: scan_unsorted(Unsorted/)
Scanner --> MainCLI: media files, other files

alt no media files
    MainCLI --> User: "Nothing to do"
else media files found
    MainCLI -> ExifTool: read_tags(files) (batches of 100)
    ExifTool --> MainCLI: date + GPS tags per file

    loop for each media file
        MainCLI -> ProcessingState: compute_file_hash(file)
        MainCLI -> MetadataService: create_image_metadata(path, tags, geo_lookup)
        MetadataService -> GeoLookup: lookup(gps)
        GeoLookup --> MetadataService: Location(country, city, timezone) | None
        MetadataService -> MetadataService: pick_capture_time(tags, timezone)
        MetadataService --> MainCLI: ImageMetadata
    end

    MainCLI -> Organizer: plan_moves(paths, items, db_path)
    Organizer -> ProcessingState: get_recorded_destination(hash)
    Organizer --> MainCLI: list[PlannedMove] (SORTED / UNKNOWN / DUPLICATE)
    MainCLI --> User: plan summary

    alt --dry-run
        MainCLI --> User: list planned moves, exit
    else user answers "y" (or --yes)
        MainCLI -> Organizer: execute_moves(paths, planned, db_path)
        Organizer -> ProcessingState: record_processed_image(hash, src, dst)
        Organizer --> MainCLI: MoveResult
        MainCLI -> Scanner: remove_empty_folders(Unsorted/)
        MainCLI --> User: summary (sorted / _Unknown / duplicates / failed)
    else user cancels
        MainCLI --> User: "Cancelled"
    end
end

Launcher --> User: "Press any key" (window stays open)

@enduml
