@startuml Image-Sorter-Run-Flow

actor User
participant MainCLI
participant "ImagePath\n(get_image_dir)" as ImagePath
participant "Logger\n(set_logger)" as Logger
participant "ProcessingState\n(SQLite)" as ProcessingState
participant "Image Reader\n(get_image_coords)" as ImageReader
participant "Metadata Service\n(create_image_metadata)" as MetadataService
participant "Geocoder\n(get_location_from_gps)" as Geocoder
participant "Organizer\n(organize_images)" as Organizer

User -> MainCLI: run `python main.py [--image-dir] [--dry-run] [--verbose|--log-level]`
MainCLI -> MainCLI: parse_args()
MainCLI -> ImagePath: get_image_dir(image_dir)
ImagePath --> MainCLI: valid path or ""

alt invalid path
    MainCLI --> User: print invalid directory and exit
else valid path
    MainCLI -> Logger: set_logger(name="main", mode="w", level=...)
    Logger --> MainCLI: logger
    MainCLI -> ProcessingState: initialize_processing_state(image_dir)
    ProcessingState --> MainCLI: db_path

    loop for each supported image file in image_dir
        MainCLI -> ProcessingState: compute_file_hash(source_path)
        ProcessingState --> MainCLI: file_hash

        MainCLI -> ProcessingState: is_hash_processed(db_path, file_hash)
        ProcessingState --> MainCLI: true/false

        alt already processed
            MainCLI -> Logger: info("Skipping already processed image")
        else not processed
            MainCLI -> ImageReader: get_image_coords(image_dir, filename)
            ImageReader --> MainCLI: timestamp, coords

            MainCLI -> MetadataService: create_image_metadata(timestamp, coords, ...)
            MetadataService -> Geocoder: get_location_from_gps(lat, lon, image_dir)
            Geocoder --> MetadataService: Location(country, city)
            MetadataService --> MainCLI: ImageMetadata

            MainCLI -> Organizer: organize_images(..., dry_run)
            Organizer --> MainCLI: destination_path | None

            alt move/plan succeeded and not dry-run
                MainCLI -> ProcessingState: record_processed_image(db_path, hash, src, dst)
                ProcessingState --> MainCLI: stored
            else dry-run
                MainCLI -> Logger: info("[DRY RUN] Skip DB write")
            else failed move
                MainCLI -> Logger: error("Failed to organize image")
            end
        end
    end

    MainCLI --> User: print total runtime
end

@enduml
